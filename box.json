{
    "chmod": "0755",
    "main": "unfinalize",
    "output": "builds/unfinalize",
    "directories": [
        "app",
        "bootstrap",
        "config",
        "vendor"
    ],
    "files": [
        "composer.json"
    ],
    "exclude-dev-files": false,
    "exclude-composer-files": false,
    "compression": "GZ",
    "compactors": [
        "KevinGH\\Box\\Compactor\\Php",
        "KevinGH\\Box\\Compactor\\Json"
    ],
    "git-version": "git-version",
    "blacklist": [
        "humbug/php-scoper",
        "pestphp",
        "mockery",
        "phpunit",
        "spatie/ray"
    ]
}
